# Example for an Nginx http block on the same host as the Compose stack.
# Replace certificate files and the fictional hostname before use.
# Never log $request or $request_uri: simple push URLs contain credentials.
map $uri $upaffe_log_path {
    default $uri;
    ~*^/api/report/ "/api/report/[redacted]";
}

log_format upaffe_safe '$remote_addr $request_method $upaffe_log_path $status';

server {
    listen 80;
    server_name status.example.test;
    access_log /var/log/nginx/upaffe-access.log upaffe_safe;
    error_log /dev/null emerg;

    location ~* ^/api/report/ {
        return 400;
    }

    location / {
        return 308 https://status.example.test$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name status.example.test;
    ssl_certificate /etc/ssl/upaffe/fullchain.pem;
    ssl_certificate_key /etc/ssl/upaffe/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;
    access_log /var/log/nginx/upaffe-access.log upaffe_safe;
    error_log /dev/null emerg;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host status.example.test;
        proxy_set_header X-Forwarded-Host status.example.test;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Prefix "";
    }
}
