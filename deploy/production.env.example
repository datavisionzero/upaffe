# Copy to .env beside the Compose files and replace the digest placeholder.
# The v0.1.0 release's image-digest.txt contains the complete value to use.
UPAFFE_IMAGE=ghcr.io/datavisionzero/upaffe@sha256:REPLACE_WITH_RELEASE_IMAGE_DIGEST
UPAFFE_PORT=8080
# Set both after starting the stack and inspecting the edge network gateway.
# Leave both empty for direct local HTTP before configuring an HTTPS proxy.
UPAFFE_TRUSTED_PROXY_IPS=
UPAFFE_PUBLIC_ORIGIN=
# Keep PostgreSQL on the same major version until its data is migrated separately.
UPAFFE_POSTGRES_IMAGE=postgres:18
